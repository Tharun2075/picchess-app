# Cloudflare Pages headers (also a readable spec for any other static host).
# Cloudflare Pages serves app/ as the site root; see docs/DEPLOY.md.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://picchess-share.picchess.workers.dev; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  # Only needed for a FUTURE multi-threaded Stockfish (SharedArrayBuffer needs cross-origin isolation).
  # The current single-threaded build does not need them; enabling them also blocks any cross-origin
  # resource that does not send CORP headers, so leave them off until the engine is swapped.
  # Cross-Origin-Opener-Policy: same-origin
  # Cross-Origin-Embedder-Policy: require-corp

# Service worker and manifest must always revalidate so updates are picked up.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# Large, rarely changing engine files: cache hard (the service worker also keeps them).
/engine/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable
/engine/*.js
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=86400

# Digital Asset Links for the Android app (Trusted Web Activity).
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
